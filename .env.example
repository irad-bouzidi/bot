# Copy to .env in the repo root. docker compose reads it automatically.
#
#   cp .env.example .env
#
# .env is gitignored. These defaults work out of the box on a loopback-only
# setup; change POSTGRES_PASSWORD before the database is reachable by anything
# other than this machine.

POSTGRES_DB=tradingbot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot

# Host-side ports. Both are published to 127.0.0.1 ONLY -- see the comments in
# docker-compose.yml. Change the number, not the bind address.
POSTGRES_PORT=5432
FRONTEND_PORT=3000

# The API URL THE BROWSER uses, injected into the page at container start.
# 127.0.0.1 because the backend runs on the host (it needs the MT5 terminal),
# not in a container -- so this is not reachable from inside the frontend
# container, and does not need to be.
BOT_API_BASE=http://127.0.0.1:8000

# --- News blackout (S9) -----------------------------------------------------
# The bot stands aside 30 minutes either side of a high/medium-impact release
# for the symbol's currency, and CLOSES any position it holds when a window
# opens. Events come from ForexFactory's public JSON -- no API key.
#
# It FAILS CLOSED: if the calendar cannot be read, no new trades are opened.
# That is deliberate, and it means a provider outage stops entries. The reason
# is shown on the dashboard card and in GET /health, so it can be told apart
# from a crash. Set BOT_NEWS_ENABLED=0 to turn the whole rule off.
BOT_NEWS_ENABLED=1

# Window, in minutes either side of the release.
BOT_NEWS_BEFORE_MIN=30
BOT_NEWS_AFTER_MIN=30

# Which impact levels black out trading. "holiday" is parsed and archived but
# is not a release at a known instant, so it is not a sensible entry here.
BOT_NEWS_IMPACTS=high,medium

# How stale a calendar may get before entries stop, in minutes. This -- not an
# individual failed request -- is what closes the gate, so a transient 500 does
# not halt the strategy. 0 is the strictest reading: any failed refresh blocks
# immediately. The default gives three refresh attempts before it bites.
BOT_NEWS_MAX_AGE_MIN=90

# Seconds between refreshes. The feed publishes days ahead, so polling harder
# buys nothing -- and the host answered HTTP 429 when probed twice in a minute.
BOT_NEWS_REFRESH_SEC=1800
BOT_NEWS_TIMEOUT_SEC=10

# Comma-separated. Only ff_calendar_thisweek.json is live; the nextweek and
# lastweek URLs that circulate alongside it both 404 (checked 2026-09-04).
BOT_NEWS_URLS=https://nfs.faireconomy.media/ff_calendar_thisweek.json
